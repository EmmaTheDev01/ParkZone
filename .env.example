# ==============================================================================
# ParkZone Mobile App Environment Variables (.env)
# ==============================================================================

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anonymous Public Key (from Supabase Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# Optional: Email Service Tokens (if running custom mailer scripts)
MAILTRAP_TOKEN=your_mailtrap_api_token
RESEND_API_KEY=re_your_resend_api_key
