# Supabase Edge Functions Environment Variables
# These can be set via `supabase secrets set KEY=VALUE` or in your Supabase Dashboard under Project Settings -> Edge Functions

# Supabase URL and Service Role Key (automatically provided in hosted Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email Provider Configuration (e.g. Resend https://resend.com)
RESEND_API_KEY=re_123456789
FROM_EMAIL="ParkZone <onboarding@resend.dev>"
